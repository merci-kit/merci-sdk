# ─────────────────────────────────────────────────────────────────────────────
#  Merci SDK — credentials template
#
#  1. Copy this file to `secret.env` in your project (a repo checkout, or
#     `node_modules/merci-sdk/` when installed from npm):
#         cp secret.env.example secret.env
#  2. Set PROVIDER and that provider's credentials.
#  3. Fill in only what you use; every other key is optional.
#
#  `secret.env` is gitignored — never commit it. This template is safe to share.
#  Verify with:  node examples/01_quickstart.mjs
# ─────────────────────────────────────────────────────────────────────────────


# ── Active provider (REQUIRED) ───────────────────────────────────────────────
# One of: jai | openrouter | openai | local | google_genai | vertex | anthropic | opencode
PROVIDER=openai

# Optional wire protocol for the active provider.
#   openai / openrouter / opencode / local : completions | responses
#   anthropic                              : messages
#   google_genai / vertex                  : generateContent
#   jai                                    : chat | responses
# PROTOCOL=responses

# Historical OpenAI-only override; wins over PROTOCOL when set.
# OPENAI_PROTOCOL=responses


# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# DEFAULT_OPENAI_MODEL=<model-id>
# DEFAULT_OPENAI_TOOL_MODEL=<cheap-model-id>
# DEFAULT_OPENAI_EMBEDDING_MODEL=<embedding-model-id>
# DEFAULT_OPENAI_DECISION_MODEL=<decision-model-id>


# ── Anthropic ────────────────────────────────────────────────────────────────
# Anthropic has no embedding endpoint; EMBEDDING_PROVIDER must point elsewhere.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# DEFAULT_ANTHROPIC_MODEL=<model-id>
# DEFAULT_ANTHROPIC_TOOL_MODEL=<cheap-model-id>


# ── Google GenAI (Gemini Developer API) ──────────────────────────────────────
# GEMINI_API_KEY=<api-key>
# DEFAULT_GOOGLE_GENAI_MODEL=<model-id>
# DEFAULT_GOOGLE_GENAI_TOOL_MODEL=<cheap-model-id>
# DEFAULT_GOOGLE_GENAI_EMBEDDING_MODEL=<embedding-model-id>
# DEFAULT_GOOGLE_GENAI_DECISION_MODEL=<decision-model-id>


# ── Vertex AI ────────────────────────────────────────────────────────────────
# Same wire as google_genai, different auth. `vertex-sa.json` must stay gitignored.
# VERTEX_CREDENTIALS=./vertex-sa.json
# VERTEX_LOCATION=us-central1
# DEFAULT_VERTEX_MODEL=<model-id>
# DEFAULT_VERTEX_TOOL_MODEL=<cheap-model-id>
# DEFAULT_VERTEX_EMBEDDING_MODEL=<embedding-model-id>


# ── OpenRouter ───────────────────────────────────────────────────────────────
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_URL=https://openrouter.ai/api/v1
# DEFAULT_OPENROUTER_MODEL=<model-id>
# DEFAULT_OPENROUTER_TOOL_MODEL=<cheap-model-id>
# DEFAULT_OPENROUTER_EMBEDDING_MODEL=<embedding-model-id>
# DEFAULT_OPENROUTER_DECISION_MODEL=<decision-model-id>


# ── OpenCode ─────────────────────────────────────────────────────────────────
# OPENCODE_API_KEY=<api-key>
# OPENCODE_URL=https://opencode.ai/zen/v1
# OPENCODE_TIER=zen
# DEFAULT_OPENCODE_MODEL=<model-id>
# DEFAULT_OPENCODE_TOOL_MODEL=<cheap-model-id>
# DEFAULT_OPENCODE_EMBEDDING_MODEL=<embedding-model-id>
# DEFAULT_OPENCODE_DECISION_MODEL=<decision-model-id>


# ── Local (LM Studio, or any OpenAI-compatible server) ───────────────────────
# LM_STUDIO_URL=http://localhost:1234/v1
# DEFAULT_LOCAL_MODEL=<model-id>
# DEFAULT_LOCAL_TOOL_MODEL=<cheap-model-id>
# DEFAULT_LOCAL_EMBEDDING_MODEL=<embedding-model-id>


# ── JAI ──────────────────────────────────────────────────────────────────────
# No endpoint ships with the package: JAI_BASE_URL is required when PROVIDER=jai.
# JAI_TOKEN=<bearer-token>
# JAI_BASE_URL=https://<your-gateway>
# DEFAULT_JAI_MODEL=<model-id>
# DEFAULT_JAI_TOOL_MODEL=<cheap-model-id>
# DEFAULT_JAI_EMBEDDING_DIMENSIONS=1024
# JAI_HEADER_TIMEOUT_MS=600000
# JAI_CONNECT_TIMEOUT_MS=30000


# ── Per-role routing (optional) ──────────────────────────────────────────────
# Each role falls back to PROVIDER, then to that provider's DEFAULT_*_MODEL.
# GENERATIVE_PROVIDER=openai
# GENERATIVE_MODEL=<model-id>
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=<embedding-model-id>
# DECISION_PROVIDER=openrouter
# DECISION_MODEL=<decision-model-id>

# Generic embedding fallback when the provider has no specific key.
# DEFAULT_EMBEDDING_MODEL=<embedding-model-id>


# ── Web tools (optional) ─────────────────────────────────────────────────────
# TAVILY_API_KEY=tvly-...
# WEBSEARCH_MODE=native_with_tavily_fallback
#   off | native | tavily | native_with_tavily_fallback
# WEBSCRAPE_MODE=native_with_tavily_fallback
#   off | native | tavily | curl | native_with_tavily_fallback | native_with_curl_fallback
# Binary for the headless browser leg (defaults to `obscura` on PATH).
# OBSCURA_BINARY=obscura


# ── Environment and limits (optional) ────────────────────────────────────────
# Point the loader at a different credentials file.
# MERCI_ENV_FILE=/absolute/path/to/secret.env
# Disable named limits (comma-separated registry keys); see docs/LIMITS.md.
# MERCI_LIMITS_DISABLED=
